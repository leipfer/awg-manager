// AWG Manager: разрешаем управление туннелем активной локальной сессии
// без запроса пароля. Пользователь должен быть в группе sudo или adm.
polkit.addRule(function(action, subject) {
    if (action.id == "org.awgmanager.manage" &&
        subject.local && subject.active &&
        (subject.isInGroup("sudo") || subject.isInGroup("adm") ||
         subject.isInGroup("wheel"))) {
        return polkit.Result.YES;
    }
});
