<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>AWG Manager</vendor>

  <action id="org.awgmanager.manage">
    <description>Управление туннелями AmneziaWG</description>
    <description xml:lang="en">Manage AmneziaWG tunnels</description>
    <message>Требуется авторизация для управления VPN-туннелем AmneziaWG</message>
    <message xml:lang="en">Authentication is required to manage the AmneziaWG tunnel</message>
    <icon_name>network-vpn</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/awg-manager/awg-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
